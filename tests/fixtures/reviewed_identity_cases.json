      "first_sentence": {
        "type": "/type/text",
        "value": "I teach a class in strategic management at Stanford University's business school as a part-time departure from my job as president and CEO of Intel Corporation."
      },
      "first_publish_date": "1996",
      "key": "/works/OL2355832W",
      "authors": [

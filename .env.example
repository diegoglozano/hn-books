DATABASE_PATH=/data/hn_books.db
OPENLIBRARY_BASE_URL=https://openlibrary.org
HN_BASE_URL=https://hacker-news.firebaseio.com/v0
ALGOLIA_BASE_URL=https://hn.algolia.com/api/v1
# Comma-separated thread IDs, fetched by the daily command.
HN_THREAD_IDS=
# Identify your installation to upstream services; optionally include a contact address.
HTTP_USER_AGENT=HNOpinionatedLibrary/0.1
HTTP_TIMEOUT=30
HN_FETCH_WORKERS=8
METADATA_INTERVAL=1.1
# Read-only debug endpoints are disabled unless a token is set.
ADMIN_TOKEN=
